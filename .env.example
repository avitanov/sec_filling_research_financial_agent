SEC_USER_AGENT="Your Name your-email@example.com"

# Amazon Bedrock
AWS_REGION="<your-aws-region>"
AWS_PROFILE="<your-aws-profile>"
BEDROCK_NOVA_LITE_MODEL_ID="amazon.nova-lite-v1:0"
# Main experiment model.
BEDROCK_SONNET_MODEL_ID="us.anthropic.claude-sonnet-4-5-20250929-v1:0"
# Evaluation judge model.
BEDROCK_HAIKU_MODEL_ID="us.anthropic.claude-haiku-4-5-20251001-v1:0"
EVALUATION_JUDGE_MODEL_ID="us.anthropic.claude-haiku-4-5-20251001-v1:0"
EVALUATION_JUDGE_MAX_TOKENS="5000"
EVALUATION_JUDGE_THINKING_BUDGET_TOKENS="1024"
EVALUATION_JUDGE_TIMEOUT_SECONDS="120"
BEDROCK_LUNA_MODEL_ID="openai.gpt-5.6-luna"
BEDROCK_REASONING_MODE="none"
BEDROCK_MANTLE_TIMEOUT_SECONDS="120"
# Created by: python scripts/configure_guardrail.py
BEDROCK_GUARDRAIL_ID="<your-guardrail-id>"
BEDROCK_GUARDRAIL_VERSION="DRAFT"

# Main comparison keeps Sonnet 4.5 thinking disabled in every stage.
DECOMPOSED_RESEARCH_MAX_TOKENS="4096"
DECOMPOSED_MATH_MAX_TOKENS="8192"
DECOMPOSED_VERIFIER_MAX_TOKENS="10000"
DECOMPOSED_MATH_THINKING_BUDGET_TOKENS="0"
DECOMPOSED_VERIFIER_THINKING_BUDGET_TOKENS="0"

# Local Qdrant filing index
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="sec_filing_chunks_v1"
QDRANT_TIMEOUT_SECONDS="30"

# Phase 1 development model (OpenRouter only; never used for scored runs)
OPENROUTER_API_KEY="<your-openrouter-api-key>"
OPENROUTER_MODEL="openai/gpt-oss-20b"
OPENROUTER_PROVIDER="coreweave"
OPENROUTER_REASONING_EFFORT="low"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Langfuse EU Cloud observability
LANGFUSE_PUBLIC_KEY="<your-langfuse-public-key>"
LANGFUSE_SECRET_KEY="<your-langfuse-secret-key>"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
LANGFUSE_TRACING_ENVIRONMENT="development"

# Demo Ask-page conversation history — Amazon Bedrock AgentCore Memory.
# The resource is created on first use if absent, tagged project=<value>; any
# non-empty value satisfies the tag-on-create requirement. Set AGENTCORE_MEMORY_ID
# to reuse an existing resource and skip creation. Uses AWS_REGION and the same
# credentials as Bedrock. Optional: without it the Ask page keeps history only
# for the current browser session.
AGENTCORE_PROJECT_TAG="financial-agent-demo"
AGENTCORE_MEMORY_NAME="financial_agent_demo"
AGENTCORE_MEMORY_ID=""
AGENTCORE_EVENT_EXPIRY_DAYS="30"
AGENTCORE_ACTOR_ID="demo-user"
