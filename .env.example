SEC_USER_AGENT="Your Name your-email@example.com"

# Amazon Bedrock
AWS_REGION="<your-aws-region>"
AWS_PROFILE="<your-aws-profile>"
BEDROCK_HAIKU_MODEL_ID="us.anthropic.claude-haiku-4-5-20251001-v1:0"
BEDROCK_LUNA_MODEL_ID="openai.gpt-5.6-luna"
BEDROCK_MANTLE_TIMEOUT_SECONDS="30"

# Local Qdrant filing index
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="sec_filing_chunks_v1"
QDRANT_TIMEOUT_SECONDS="30"
